---
/**
 * Architecture diagram for a system pattern.
 * The SVG files in ./diagrams/ are static, hand-checked drawings (one shared
 * drawing spec). The SVG is decorative for assistive tech; the caption and the
 * numbered flow below it carry the meaning in text.
 *
 * Motion: lines draw and nodes appear as the figure scrolls into view, only
 * where scroll-driven animation is supported and motion is welcome. Everywhere
 * else the drawing is complete from the start.
 */
import type { Pattern } from '../data/content';
import monitoring from './diagrams/monitoring.svg?raw';
import catalogue from './diagrams/catalogue.svg?raw';
import assistants from './diagrams/assistants.svg?raw';
import earlyWarning from './diagrams/early-warning.svg?raw';
import knowledge from './diagrams/knowledge.svg?raw';

interface Props {
  pattern: Pattern;
  /** Show the numbered flow under the drawing (default true). */
  flow?: boolean;
}

const svgs = { monitoring, 'early-warning': earlyWarning, catalogue, knowledge, assistants } as const;
const { pattern, flow = true } = Astro.props;
const captionId = `${pattern.slug}-diagram-caption`;
---

<figure class="diagram" aria-labelledby={captionId}>
  <div
    class="diagram__canvas"
    tabindex="0"
    role="region"
    aria-label={`${pattern.title} diagram (scrolls sideways on small screens)`}
    set:html={svgs[pattern.slug]}
  />
  <p class="diagram__hint" aria-hidden="true">Swipe sideways to see the whole diagram.</p>
  <figcaption id={captionId} class="diagram__caption">{pattern.caption}</figcaption>
  {
    flow && (
      <ol class="diagram__flow" role="list">
        {pattern.flow.map((step) => (
          <li>{step}</li>
        ))}
      </ol>
    )
  }
</figure>

<style>
  .diagram {
    margin: 0;
    display: grid;
    gap: 1rem;
  }
  .diagram__canvas {
    overflow-x: auto;
    padding: 0.75rem;
    border: 1px solid var(--rule);
    border-radius: var(--radius-m);
    /* Inset shadow: the canvas reads as a recessed panel the cards sit in. */
    box-shadow:
      inset 0 3px 10px rgb(11 53 88 / 0.10),
      inset 0 1px 2px rgb(11 53 88 / 0.06);
    background:
      radial-gradient(circle at 1px 1px, rgb(42 111 153 / 0.14) 1px, transparent 0) 0 0 / 16px 16px,
      #fbfcfd;
    scrollbar-width: thin;
  }
  .diagram__canvas :global(svg) {
    display: block;
    width: 100%;
    min-width: 36rem;
    height: auto;
    overflow: visible;
  }

  /* Cards: icon on top, name below. People in leaf green, outside systems dashed,
     data stores tinted blue. */
  .diagram__canvas :global(.n) {
    fill: #fff;
    stroke: var(--rule);
    stroke-width: 1;
    filter: drop-shadow(0 1px 1px rgb(11 53 88 / 0.06)) drop-shadow(0 6px 14px rgb(11 53 88 / 0.08));
  }
  .diagram__canvas :global(.node--person .n) {
    fill: var(--green-soft);
    stroke: #cfe0bf;
  }
  .diagram__canvas :global(.node--store .n) {
    fill: #f2f7fb;
    stroke: #d2e2ee;
  }
  .diagram__canvas :global(.node--external .n) {
    fill: #fbfcfd;
    stroke: #b9c9d5;
    stroke-dasharray: 4 3;
    filter: none;
  }
  .diagram__canvas :global(.t) {
    fill: var(--ink);
    font-family: var(--font);
    font-size: 12.5px;
    font-weight: 600;
    letter-spacing: -0.01em;
    text-anchor: middle;
  }
  .diagram__canvas :global(.node--person .t) {
    fill: var(--green-ink);
  }
  .diagram__canvas :global(.node--external .t) {
    fill: var(--text);
    font-weight: 500;
  }
  .diagram__canvas :global(.e) {
    fill: none;
    stroke: #8fb3cc;
    stroke-width: 1.4;
  }
  .diagram__canvas :global(.arrowhead) {
    fill: none;
    stroke: #8fb3cc;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .diagram__hint {
    display: none;
    font-size: 0.85rem;
    color: var(--text-muted);
  }
  @media (max-width: 40em) {
    .diagram__hint {
      display: block;
    }
  }
  .diagram__caption {
    font-size: 0.95rem;
    color: var(--text-muted);
  }

  .diagram__flow {
    list-style: none;
    counter-reset: flow;
    display: grid;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
  }
  .diagram__flow li {
    counter-increment: flow;
    display: grid;
    grid-template-columns: 1.75rem 1fr;
    color: var(--text);
  }
  .diagram__flow li::before {
    content: counter(flow);
    font-family: var(--font-mono);
    font-size: 0.85rem;
    line-height: 1.9;
    color: var(--blue);
  }

  /* Line-draw: only where supported and wanted. Fail-open everywhere else. */
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .diagram__canvas :global(.e) {
        stroke-dasharray: 1;
        animation: diagram-draw linear both;
        animation-timeline: view();
        animation-range: entry calc(10% + var(--i) * 6%) cover calc(35% + var(--i) * 4%);
        animation-timing-function: var(--ease-draw);
      }
      .diagram__canvas :global(.node) {
        animation: diagram-node linear both;
        animation-timeline: view();
        animation-range: entry calc(var(--i) * 6%) cover 30%;
      }
    }
  }

  @keyframes diagram-draw {
    from {
      stroke-dashoffset: 1;
      opacity: 0;
    }
    8% {
      opacity: 1;
    }
    to {
      stroke-dashoffset: 0;
      opacity: 1;
    }
  }
  @keyframes diagram-node {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }
</style>
