---
import Base from '../layouts/Base.astro';
import HeroVisual from '../components/HeroVisual.astro';
import Icon from '../components/Icon.astro';
import PartnerBand from '../components/PartnerBand.astro';
import ApproachSteps from '../components/ApproachSteps.astro';
import { pillars, capabilities, sectors } from '../data/content';
import { url } from '../config/site';
---

<Base>
  <!-- A. Hero -->
  <section class="hero">
    <div class="container hero__grid">
      <div class="hero__copy">
        <h1>Technology for a better world.</h1>
        <p class="lede hero__lede">
          We transform data, technology, and innovation into practical solutions that help organizations and
          communities around the world address complex challenges.
        </p>
        <div class="button-row">
          <a class="button" href={url('/expertise')}>Explore our expertise</a>
          <a class="button button--ghost" href={url('/contact')}>Partner with us</a>
        </div>
      </div>
      <div class="hero__visual">
        <HeroVisual />
      </div>
    </div>

    <div class="container">
      <p class="hero__audience">
        Working with international development organizations, NGOs, government institutions, multilateral agencies,
        research institutions, social enterprises, and the private sector.
      </p>
    </div>
  </section>

  <!-- B. What we do -->
  <section class="section" aria-labelledby="what-title">
    <div class="container split">
      <div class="split__aside section-head">
        <p class="kicker">What we do</p>
        <h2 id="what-title">A technology partner for complex challenges.</h2>
        <p>
          DevDataWorks works where technology, data, and sustainable development meet. We help organizations turn
          difficult problems into working solutions: systems people use, evidence leaders trust, and results that
          last beyond the project.
        </p>
      </div>

      <ul class="pillars" role="list">
        {
          pillars.map((p) => (
            <li class="pillar">
              <span class="icon-badge">
                <Icon name={p.icon} />
              </span>
              <div>
                <h3>{p.title}</h3>
                <p>{p.text}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- C. Expertise -->
  <section class="section section--rule" id="expertise" aria-labelledby="expertise-title">
    <div class="container">
      <div class="row-head">
        <div class="section-head">
          <p class="kicker">Our expertise</p>
          <h2 id="expertise-title">Capabilities that work together.</h2>
        </div>
        <div class="row-head__aside">
          <p>
            From the first assessment to long-term support, we bring together the skills needed to design, build,
            and sustain digital solutions.
          </p>
          <a class="text-link" href={url('/expertise')}>
            View all expertise <Icon name="arrow" size={18} />
          </a>
        </div>
      </div>

      <ul class="capabilities" role="list">
        {
          capabilities.map((c) => (
            <li class="capability">
              <a href={url(`/expertise#${c.slug}`)} class="capability__link">
                <Icon name={c.icon} size={28} class="capability__icon" />
                <h3>{c.title}</h3>
                <p>{c.summary}</p>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- D. Sectors -->
  <section class="section section--mist" aria-labelledby="sectors-title">
    <div class="container split">
      <div class="split__aside section-head">
        <p class="kicker">Sectors we support</p>
        <h2 id="sectors-title">Sector-agnostic by design.</h2>
        <p>
          The questions differ from one field to another, yet the needs are often shared: reliable data, systems
          that fit the context, and insight that leads to action. We bring the same rigor to every sector we work
          in.
        </p>
        <a class="text-link" href={url('/sectors')}>
          Explore sectors <Icon name="arrow" size={18} />
        </a>
      </div>

      <ul class="sectors" role="list">
        {
          sectors.map((s) => (
            <li class="sector">
              <Icon name={s.icon} size={26} class="sector__icon" />
              <h3>{s.title}</h3>
              <p>{s.summary}</p>
            </li>
          ))
        }
        <li class="sector sector--open">
          <Icon name="horizon" size={26} class="sector__icon" />
          <div>
            <h3>And the challenges still emerging</h3>
            <p>
              Our methods are not tied to a single field. If your work depends on better information and better
              tools, we would like to hear about it.
            </p>
          </div>
        </li>
      </ul>
    </div>
  </section>

  <!-- E. Approach -->
  <section class="section" id="approach" aria-labelledby="approach-title">
    <div class="container">
      <div class="row-head">
        <div class="section-head">
          <p class="kicker">Our approach</p>
          <h2 id="approach-title">How we work with partners.</h2>
        </div>
        <div class="row-head__aside">
          <p>
            Good technology comes from close collaboration. Our process keeps your team involved at every stage and
            plans for long-term sustainability from day one.
          </p>
        </div>
      </div>

      <ApproachSteps />
    </div>
  </section>

  <!-- F. Partnership -->
  <PartnerBand />
</Base>

<style>
  /* Hero */
  .hero {
    position: relative;
    padding-block: clamp(3rem, 6vw, 5.5rem) clamp(3rem, 5vw, 4.5rem);
    background:
      radial-gradient(60rem 40rem at 85% 30%, var(--blue-soft) 0%, transparent 60%),
      #fff;
    border-bottom: 1px solid var(--line);
  }
  .hero__grid {
    display: grid;
    gap: 3rem;
    align-items: center;
  }
  @media (min-width: 60em) {
    .hero__grid {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
      gap: 4rem;
      min-height: min(64vh, 40rem);
    }
  }
  .hero__copy {
    display: grid;
    gap: 1.75rem;
    justify-items: start;
  }
  .hero h1 {
    max-width: 11ch;
    font-size: clamp(3rem, 1.6rem + 5.2vw, 5.75rem);
  }
  .hero__lede {
    max-width: 33rem;
  }
  .hero .button-row {
    margin-top: 0.5rem;
  }
  .hero__visual {
    max-width: 20rem;
    width: 100%;
    margin-inline: auto;
  }
  @media (min-width: 60em) {
    .hero__visual {
      max-width: none;
    }
  }
  .hero__audience {
    margin-top: clamp(1.5rem, 3vw, 2.5rem);
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
    max-width: 56rem;
    color: var(--text-muted);
    font-size: 0.975rem;
  }

  /* Pillars */
  .pillars {
    list-style: none;
    display: grid;
  }
  .pillar {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 1.5rem;
    padding-block: 2rem;
    border-top: 1px solid var(--line);
  }
  .pillar:first-child {
    padding-top: 0;
    border-top: 0;
  }
  .pillar h3 {
    font-size: var(--step-3);
    margin-bottom: 0.6rem;
  }
  .pillar p {
    max-width: 34rem;
  }

  /* Row head: heading left, supporting text right */
  .section--rule {
    border-top: 1px solid var(--line);
  }
  .row-head {
    display: grid;
    gap: 1.5rem;
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
  }
  @media (min-width: 56em) {
    .row-head {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      gap: clamp(3rem, 6vw, 6rem);
      align-items: end;
    }
  }
  .row-head__aside {
    display: grid;
    gap: 1.25rem;
    justify-items: start;
    max-width: var(--measure);
  }

  /* Capabilities */
  .capabilities {
    list-style: none;
    display: grid;
    gap: 0 clamp(2rem, 4vw, 3.5rem);
  }
  @media (min-width: 40em) {
    .capabilities {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 64em) {
    .capabilities {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .capability__link {
    position: relative;
    display: grid;
    gap: 0.75rem;
    height: 100%;
    padding-block: 2rem 2.5rem;
    border-top: 1px solid var(--line);
    color: inherit;
    text-decoration: none;
  }
  .capability__link::before {
    content: '';
    position: absolute;
    top: -1px;
    left: 0;
    width: 100%;
    height: 2px;
    background: var(--blue);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.45s var(--ease);
  }
  .capability__link:hover::before,
  .capability__link:focus-visible::before {
    transform: scaleX(1);
  }
  .capability__link :global(.capability__icon) {
    color: var(--blue);
    margin-bottom: 0.5rem;
  }
  .capability__link h3 {
    transition: color 0.25s var(--ease);
  }
  .capability__link:hover h3 {
    color: var(--blue);
  }

  /* Sectors */
  .sectors {
    list-style: none;
    display: grid;
    gap: 1rem;
  }
  @media (min-width: 36em) {
    .sectors {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  .sector {
    display: grid;
    align-content: start;
    gap: 0.5rem;
    padding: 1.75rem;
    background: #fff;
    border: 1px solid var(--line);
    border-radius: var(--radius-m);
  }
  .sector :global(.sector__icon) {
    color: var(--green-ink);
    margin-bottom: 0.75rem;
  }
  .sector p {
    font-size: 0.975rem;
    color: var(--text-muted);
  }
  .sector--open {
    grid-column: 1 / -1;
    grid-template-columns: auto 1fr;
    gap: 1.25rem;
    background: transparent;
    border: 1.5px dashed #b9c9d5;
  }
  .sector--open :global(.sector__icon) {
    color: var(--blue);
    margin: 0.15rem 0 0;
  }
  .sector--open h3 {
    margin-bottom: 0.4rem;
  }
</style>
