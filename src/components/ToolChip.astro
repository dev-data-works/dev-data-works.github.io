---
/**
 * One technology chip with a small brand icon in the brand's own colour
 * (src/data/tool-icons.ts). Labels without an icon render as text only.
 */
import { toolIcons, toolIconFor } from '../data/tool-icons';

interface Props {
  label: string;
}
const { label } = Astro.props;
const icon = toolIconFor[label] ? toolIcons[toolIconFor[label]] : undefined;
// Very light brand colours would vanish on white: draw those in ink instead.
const color = icon?.hex && parseInt(icon.hex.slice(1), 16) < 0xe6e6e6 ? icon.hex : 'var(--ink)';
---

<li class="chip tool-chip">
  {
    icon?.path && (
      <svg class="tool-chip__icon" viewBox="0 0 24 24" width="14" height="14" aria-hidden="true" focusable="false">
        <path d={icon.path} fill={color} />
      </svg>
    )
  }
  {icon?.img && <img class="tool-chip__icon" src={icon.img} width="14" height="14" alt="" />}
  <span>{label}</span>
</li>

<style>
  .tool-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }
  .tool-chip__icon {
    flex: none;
    display: block;
  }
</style>
