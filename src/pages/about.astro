---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import PartnerBand from '../components/PartnerBand.astro';
import ApproachSteps from '../components/ApproachSteps.astro';
import Icon from '../components/Icon.astro';
import { principles, audiences } from '../data/content';
---

<Base
  title="About us"
  description="DevDataWorks is a technology organization that applies software, data, and innovation to help partners address complex challenges and deliver measurable impact."
>
  <PageHeader
    kicker="About us"
    title="Where technology, data, and development meet."
    lede="DevDataWorks is a technology organization dedicated to creating meaningful impact through innovative, data-driven solutions, built in partnership with the organizations working on the world’s most complex challenges."
  />

  <section class="section" aria-labelledby="mission-title">
    <div class="container split">
      <div class="split__aside section-head">
        <p class="kicker">Our mission</p>
        <h2 id="mission-title">Better information, better tools, better outcomes.</h2>
      </div>
      <div class="prose">
        <p class="lede">
          We build innovative, data-driven technology solutions that create meaningful impact across sectors,
          communities, and the world.
        </p>
        <p>
          Organizations working on development and public-interest challenges are asked to do more with less, and to
          show what difference they make. Too often, the systems they rely on were not designed for the realities of
          their work: data is fragmented, tools are hard to maintain, and insight arrives too late to inform
          decisions.
        </p>
        <p>
          DevDataWorks exists to close that gap. We combine software engineering, data expertise, and an
          understanding of how development programs operate, so that the technology we deliver is useful from the
          first day and sustainable for years after.
        </p>
        <p>
          Our expertise is deliberately sector-agnostic. Whether the challenge involves farms, clinics, classrooms,
          water systems, or public institutions, the underlying need is often the same: trustworthy information, and
          tools that help people act on it.
        </p>
      </div>
    </div>
  </section>

  <section class="section section--mist" aria-labelledby="principles-title">
    <div class="container">
      <div class="section-head principles-head">
        <p class="kicker">What guides us</p>
        <h2 id="principles-title">The principles behind our work.</h2>
      </div>
      <ul class="principles" role="list">
        {
          principles.map((p) => (
            <li class="principle">
              <h3>{p.title}</h3>
              <p>{p.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section" aria-labelledby="approach-title">
    <div class="container">
      <div class="section-head approach-head">
        <p class="kicker">How we work</p>
        <h2 id="approach-title">A process built around partnership.</h2>
        <p>Every engagement follows the same four stages, adapted to the scale and context of the work.</p>
      </div>
      <ApproachSteps />
    </div>
  </section>

  <section class="section section--rule" aria-labelledby="audience-title">
    <div class="container split">
      <div class="split__aside section-head">
        <p class="kicker">Who we work with</p>
        <h2 id="audience-title">Partners working for the public good.</h2>
        <p>
          We work with organizations of every size that share a commitment to measurable, lasting results.
        </p>
      </div>
      <ul class="audiences" role="list">
        {
          audiences.map((a) => (
            <li>
              <Icon name="check" size={20} />
              <span>{a}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <PartnerBand />
</Base>

<style>
  .principles-head,
  .approach-head {
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
  }

  .principles {
    list-style: none;
    display: grid;
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
    border-radius: var(--radius-m);
    overflow: hidden;
  }
  @media (min-width: 40em) {
    .principles {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 64em) {
    .principles {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  .principle {
    display: grid;
    align-content: start;
    gap: 0.75rem;
    padding: 2rem 1.75rem 2.25rem;
    background: #fff;
  }
  .principle::before {
    content: '';
    width: 2rem;
    height: 3px;
    border-radius: 3px;
    background: var(--green);
    margin-bottom: 0.5rem;
  }

  .section--rule {
    border-top: 1px solid var(--line);
  }

  .audiences {
    list-style: none;
    display: grid;
  }
  .audiences li {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding-block: 1.1rem;
    border-bottom: 1px solid var(--line);
    color: var(--ink);
    font-size: var(--step-1);
    font-weight: 500;
  }
  .audiences li:first-child {
    border-top: 1px solid var(--line);
  }
  .audiences :global(.icon) {
    color: var(--green-ink);
    flex: none;
  }
</style>
