---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import { url } from '../config/site';
---

<Base title="Page not found" description="This page does not exist.">
  <PageHeader
    kicker="Page not found"
    title="This page does not exist."
    lede="It may have moved. These pages are a good place to start:"
  >
    <div class="button-row">
      <a class="button" href={url('/work')}>What we build</a>
      <a class="button button--ghost" href={url('/expertise')}>Expertise</a>
      <a class="button button--ghost" href={url('/contact')}>Contact</a>
    </div>
  </PageHeader>
</Base>
