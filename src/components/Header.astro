---
/**
 * Site header. No JavaScript: on small screens the page links sit in a row
 * under the logo (always visible, the current page underlined), so visitors
 * can see every page from wherever they land.
 */
import Logo from './Logo.astro';
import { nav, url } from '../config/site';

const current = Astro.url.pathname.replace(import.meta.env.BASE_URL.replace(/\/$/, ''), '').replace(/\/$/, '') || '/';
const isCurrent = (href: string) => !href.includes('#') && current === href;
const items = [{ label: 'Home', href: '/' }, ...nav];
---

<header class="site-header">
  <div class="container site-header__inner">
    <Logo height={38} eager />

    <nav class="site-nav" aria-label="Main">
      <ul class="site-nav__list" role="list">
        {
          items.map((item) => (
            <li>
              <a
                href={url(item.href)}
                class="site-nav__link"
                aria-current={isCurrent(item.href) ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <a href={url('/contact')} class="button site-header__cta" aria-current={isCurrent('/contact') ? 'page' : undefined}
      >Contact us</a
    >
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: #fff;
    border-bottom: 1px solid var(--rule);
  }

  /* Small screens: logo + Contact on the first row, page links on the second. */
  .site-header__inner {
    display: grid;
    grid-template-columns: 1fr auto;
    grid-template-areas:
      'logo cta'
      'nav nav';
    align-items: center;
    column-gap: 1rem;
    padding-top: 0.75rem;
  }
  .site-header__inner > :global(:first-child) {
    grid-area: logo;
  }
  .site-header__cta {
    grid-area: cta;
    min-height: 2.5rem;
    padding: 0.5rem 1.05rem;
    font-size: 0.925rem;
    white-space: nowrap;
  }
  .site-nav {
    grid-area: nav;
    margin-top: 0.35rem;
    /* Scroll sideways if the links ever outgrow a very narrow screen. */
    overflow-x: auto;
    scrollbar-width: none;
  }
  .site-nav::-webkit-scrollbar {
    display: none;
  }
  /* On very narrow phones the last link can sit past the edge: fade it to show there is more. */
  @media (max-width: 23.9em) {
    .site-nav {
      mask-image: linear-gradient(to right, #000 82%, transparent);
      padding-right: 1.5rem;
    }
  }

  .site-nav__list {
    list-style: none;
    display: flex;
    gap: 1.35rem;
  }
  .site-nav__link {
    position: relative;
    display: block;
    padding: 0.6rem 0 0.7rem;
    color: var(--text);
    font-size: 0.975rem;
    font-weight: 500;
    text-decoration: none;
    white-space: nowrap;
    transition: color 0.2s var(--ease);
  }
  .site-nav__link::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 2px;
    border-radius: 2px;
    background: var(--green);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.3s var(--ease);
  }
  .site-nav__link:hover,
  .site-nav__link[aria-current='page'] {
    color: var(--ink);
  }
  .site-nav__link[aria-current='page'] {
    font-weight: 600;
  }
  .site-nav__link:hover::after,
  .site-nav__link[aria-current='page']::after {
    transform: scaleX(1);
  }

  /* Wide screens: one row. */
  @media (min-width: 56em) {
    .site-header__inner {
      grid-template-columns: auto 1fr auto;
      grid-template-areas: 'logo nav cta';
      column-gap: 2.25rem;
      min-height: 4.75rem;
      padding-top: 0;
    }
    .site-nav {
      justify-self: end;
      margin-top: 0;
      overflow: visible;
    }
    .site-nav__list {
      gap: 2rem;
    }
    .site-nav__link {
      padding: 0.4rem 0;
    }
    .site-header__cta {
      min-height: 2.75rem;
      padding: 0.55rem 1.15rem;
      font-size: 0.95rem;
    }
  }
</style>
