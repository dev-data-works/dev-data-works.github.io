---
import Base from '../layouts/Base.astro';
import HeroVisual from '../components/HeroVisual.astro';
import SectionHead from '../components/SectionHead.astro';
import PatternEntry from '../components/PatternEntry.astro';
import PlatformRow from '../components/PlatformRow.astro';
import ApproachSteps from '../components/ApproachSteps.astro';
import TeamRoles from '../components/TeamRoles.astro';
import PartnerBand from '../components/PartnerBand.astro';
import Icon from '../components/Icon.astro';
import { capabilities, patterns } from '../data/content';
import { url } from '../config/site';
---

<Base>
  <!-- Before the hero paints: on desktop with a mouse (and motion allowed) the canvas
       below owns the dot band, so the CSS dots are hidden and never seen side by side. -->
  <script is:inline>
    matchMedia('(hover:hover) and (pointer:fine) and (min-width:60em) and (prefers-reduced-motion:no-preference)')
      .matches && document.documentElement.classList.add('dots-live');
  </script>
  <section class="hero">
    <div class="container hero__grid">
      <div class="hero__copy">
        <h1>Systems that keep working where the work happens.</h1>
        <p class="lede hero__lede">
          We design and build the data and software systems behind development programmes. Our work covers tools
          that collect data in the field, platforms that bring it together, and the dashboards, maps and assistants
          that put it to use. Everything is built on open platforms, documented, and handed over so your team can
          run it.
        </p>
        <div class="button-row">
          <a class="button" href={url('/work')}>See what we build</a>
          <a class="button button--ghost" href={url('/contact')}>Contact us</a>
        </div>
      </div>
      <div class="hero__visual">
        <HeroVisual />
      </div>
    </div>
  </section>

  <section class="section" id="expertise" aria-labelledby="what-title">
    <div class="container home-split">
      <SectionHead
        index="01"
        label="What we do"
        title="From the field to a decision."
        id="what-title"
        lede="Most programme data starts on a phone in the field and should end in a decision. We cover each step in between, from software and data platforms to maps, AI and advice."
      >
        <a class="button home-more" href={url('/expertise')}>
          All expertise <Icon name="arrow" size={18} />
        </a>
      </SectionHead>
      <ul class="capabilities" role="list">
        {
          capabilities.map((c) => (
            <li>
              <a class="capability" href={url(`/expertise#${c.slug}`)}>
                <Icon name={c.icon} size={26} class="capability__icon" />
                <h3>{c.title}</h3>
                <p>{c.summary}</p>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section section--rule" aria-labelledby="build-title">
    <div class="container home-split">
      <SectionHead
        index="02"
        label="What we build"
        title="Five kinds of systems we design and build."
        id="build-title"
        lede="Each one solves a problem we see across programmes and sectors."
      >
        <a class="button home-more" href={url('/work')}>
          See the architecture of each <Icon name="arrow" size={18} />
        </a>
      </SectionHead>
      <ul class="teasers" role="list">
        {patterns.map((p) => <PatternEntry pattern={p} variant="teaser" />)}
      </ul>
    </div>
  </section>

  <section class="section section--mist" aria-labelledby="platforms-title">
    <div class="container home-stack">
      <SectionHead
        index="03"
        label="Platforms"
        title="Built on open platforms."
        id="platforms-title"
        lede="Open platforms keep costs down and leave you free to change provider."
      />
      <PlatformRow />
    </div>
  </section>

  <section class="section" id="approach" aria-labelledby="approach-title">
    <div class="container home-stack">
      <SectionHead
        index="04"
        label="How we work"
        title="How we work with partners."
        id="approach-title"
        lede="Your team is involved at every step, and the system is planned around who will run it after launch."
      />
      <ApproachSteps />
    </div>
  </section>

  <section class="section section--rule" aria-labelledby="team-title">
    <div class="container home-stack">
      <SectionHead
        index="05"
        label="Who we are"
        title="Senior people leading the work."
        id="team-title"
        lede="Our leads have spent their careers on development programmes, partnerships and the technology behind them, and bring in specialists as each project needs."
      >
        <a class="button home-more" href={url('/about')}>
          More about the team <Icon name="arrow" size={18} />
        </a>
      </SectionHead>
      <TeamRoles variant="summary" />
    </div>
  </section>

  <PartnerBand />
</Base>

<script is:inline>
  // Cursor-reactive dot band (desktop, mouse, motion allowed; see the flag above).
  // Draws the band once as a ripple from the right, then sleeps; while the mouse
  // moves over the hero, dots near it ease away and settle back when it leaves.
  (() => {
    const root = document.documentElement;
    const hero = document.querySelector('.hero');
    if (!hero || !root.classList.contains('dots-live')) return;
    const PITCH = 20, DOT = 1.5, RADIUS = 110, PUSH = 14;
    // Same stops as the CSS mask on .hero::before: [position across band, opacity].
    const BAND = [[0, 0], [0.22, 0.18], [0.58, 0.3], [0.84, 1], [1, 1]];
    const band = (f) => {
      for (let i = 1; i < BAND.length; i++) {
        const [x1, a1] = BAND[i], [x0, a0] = BAND[i - 1];
        if (f <= x1) return a0 + ((f - x0) / (x1 - x0)) * (a1 - a0);
      }
      return 1;
    };
    const canvas = document.createElement('canvas');
    canvas.className = 'hero__dots';
    canvas.setAttribute('aria-hidden', 'true');
    hero.prepend(canvas);
    const ctx = canvas.getContext('2d');
    let w = 0, h = 0, dots = [], mx = -1e4, my = -1e4, raf = 0, start = 0;

    const layout = () => {
      w = canvas.clientWidth;
      h = canvas.clientHeight;
      const dpr = devicePixelRatio || 1;
      canvas.width = Math.round(w * dpr);
      canvas.height = Math.round(h * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      dots = [];
      // Anchored at the right edge, like background-position: right top.
      for (let x = w - PITCH + 2; x > 0; x -= PITCH)
        for (let y = 2; y < h; y += PITCH) dots.push({ x, y, ox: 0, oy: 0, a: 0.5 * band(x / w) });
    };

    const frame = (t) => {
      if (!start) start = t;
      ctx.clearRect(0, 0, w, h);
      ctx.fillStyle = '#2a6f99';
      let busy = false;
      for (const d of dots) {
        // Entrance: a ripple from the right edge, about 0.9 s across the band.
        const e = Math.min(1, Math.max(0, (t - start - ((w - d.x) / w) * 600) / 350));
        if (e < 1) busy = true;
        if (!e || !d.a) continue;
        const dx = d.x - mx, dy = d.y - my, dist = Math.hypot(dx, dy) || 1;
        const k = dist < RADIUS ? (1 - dist / RADIUS) ** 2 : 0;
        const sx = ((dx / dist) * k * PUSH - d.ox) * 0.14, sy = ((dy / dist) * k * PUSH - d.oy) * 0.14;
        d.ox += sx;
        d.oy += sy;
        if (Math.abs(sx) + Math.abs(sy) > 0.02) busy = true;
        ctx.globalAlpha = Math.min(1, d.a + k * 0.35) * e;
        ctx.beginPath();
        ctx.arc(d.x + d.ox, d.y + d.oy, DOT * (0.4 + 0.6 * e) + k * 0.6, 0, 6.2832);
        ctx.fill();
      }
      root.classList.add('dots-ready');
      raf = busy ? requestAnimationFrame(frame) : 0;
    };
    const wake = () => raf || (raf = requestAnimationFrame(frame));

    hero.addEventListener('pointermove', (e) => {
      if (e.pointerType !== 'mouse') return;
      const r = canvas.getBoundingClientRect();
      mx = e.clientX - r.left;
      my = e.clientY - r.top;
      wake();
    });
    hero.addEventListener('pointerleave', () => {
      mx = my = -1e4;
      wake();
    });
    const ro = new ResizeObserver(() => {
      layout();
      wake();
    });
    ro.observe(hero);
    // Settings changed mid-visit (smaller window, reduced motion): back to the CSS dots.
    const mq = matchMedia('(hover:hover) and (pointer:fine) and (min-width:60em) and (prefers-reduced-motion:no-preference)');
    mq.addEventListener('change', () => {
      if (mq.matches) return;
      ro.disconnect();
      cancelAnimationFrame(raf);
      canvas.remove();
      root.classList.remove('dots-live', 'dots-ready');
    }, { once: true });
  })();
</script>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding-block: clamp(3rem, 6vw, 5.5rem);
    border-bottom: 1px solid var(--rule);
  }
  /*
   * A band of data points across the right three quarters of the hero: clear behind
   * the headline, a faint shade through the middle, denser on the right. The same
   * stops are mirrored in the script below (BAND), which redraws the band as a
   * cursor-reactive canvas on desktop.
   */
  .hero::before {
    content: '';
    position: absolute;
    z-index: -1;
    inset: 0 0 0 auto;
    width: 75%;
    background-image: radial-gradient(circle at 2px 2px, rgb(42 111 153 / 0.5) 1.3px, transparent 1.7px);
    background-size: 20px 20px;
    background-position: right top;
    mask-image: linear-gradient(
      to right,
      transparent 0%,
      rgb(0 0 0 / 0.18) 22%,
      rgb(0 0 0 / 0.3) 58%,
      #000 84%
    );
    pointer-events: none;
  }
  /* Desktop with a mouse: the canvas draws the band. If it never draws, the CSS
     dots come back after 1.5 s. */
  :global(.dots-live) .hero::before {
    opacity: 0;
    animation: dots-fallback 0.4s ease 1.5s forwards;
  }
  :global(.dots-live.dots-ready) .hero::before {
    display: none;
  }
  @keyframes dots-fallback {
    to {
      opacity: 1;
    }
  }
  :global(.hero__dots) {
    position: absolute;
    z-index: -1;
    inset: 0 0 0 auto;
    width: 75%;
    height: 100%;
    pointer-events: none;
  }
  /* Small screens: the text spans the width, so the band shrinks to the right third
     and stays faint. */
  @media (max-width: 59.99em) {
    .hero::before {
      width: 33.333%;
      mask-image: linear-gradient(to right, transparent, rgb(0 0 0 / 0.45) 60%, rgb(0 0 0 / 0.6));
    }
  }
  .hero__grid {
    display: grid;
    gap: 3rem;
    align-items: center;
  }
  @media (min-width: 60em) {
    .hero__grid {
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
      gap: 4rem;
      min-height: min(66vh, 42rem);
    }
  }
  .hero__copy {
    display: grid;
    gap: 1.75rem;
    justify-items: start;
  }
  .hero h1 {
    max-width: 13ch;
    font-size: clamp(2.9rem, 1.4rem + 5.4vw, 5.9rem);
    line-height: 0.98;
  }
  .hero__lede {
    max-width: 35rem;
  }
  .hero .button-row {
    margin-top: 0.25rem;
  }
  /* Small screens: no illustration; the heading leads. display: none also skips its
     layout, paint and animations. */
  @media (max-width: 59.99em) {
    .hero__visual {
      display: none;
    }
  }

  .section--rule {
    border-top: 1px solid var(--rule);
  }

  .home-split {
    display: grid;
    gap: clamp(2rem, 4vw, 3.5rem);
  }
  @media (min-width: 64em) {
    .home-split {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      gap: clamp(3rem, 6vw, 6rem);
      align-items: start;
    }
    .home-split > :global(.section-head-x) {
      position: sticky;
      top: 7rem;
    }
  }
  .home-stack {
    display: grid;
    gap: clamp(2rem, 4vw, 3.5rem);
  }

  .capabilities {
    list-style: none;
    display: grid;
    border-top: 1px solid var(--ink);
  }
  @media (min-width: 40em) {
    .capabilities {
      grid-template-columns: repeat(2, 1fr);
      column-gap: clamp(1.5rem, 3vw, 2.5rem);
    }
  }
  .capability {
    display: grid;
    align-content: start;
    gap: 0.5rem;
    height: 100%;
    padding-block: 1.5rem 1.75rem;
    border-bottom: 1px solid var(--rule);
    color: inherit;
    text-decoration: none;
  }
  .capability :global(.capability__icon) {
    color: var(--blue);
    margin-bottom: 0.35rem;
    transition: transform 0.3s var(--ease);
  }
  .capability h3 {
    font-size: var(--step-1);
    transition: color 0.25s var(--ease);
  }
  .capability p {
    color: var(--text);
    font-size: 0.975rem;
  }
  .capability:hover h3 {
    color: var(--blue);
  }
  .capability:hover :global(.capability__icon) {
    transform: translateY(-2px);
  }

  .home-more {
    margin-top: 0.5rem;
  }
  .home-more :global(.icon) {
    transition: transform 0.3s var(--ease);
  }
  .home-more:hover :global(.icon) {
    transform: translateX(3px);
  }

  .teasers {
    list-style: none;
    border-top: 1px solid var(--ink);
  }
</style>
