---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import PartnerBand from '../components/PartnerBand.astro';
import SectionHead from '../components/SectionHead.astro';
import StackList from '../components/StackList.astro';
import Icon from '../components/Icon.astro';
import { capabilities, advisoryNote, patternBySlug } from '../data/content';
import { url } from '../config/site';
---

<Base
  title="Expertise"
  description="Custom software, data platforms, data analysis and visualisation, maps and GIS, AI and automation, and digital strategy for development organisations."
>
  <PageHeader
    kicker="Expertise"
    title="What we can do for you."
    lede="Six areas of work. Each links to the system patterns that show it in practice."
  >
    <nav class="jump" aria-label="Expertise areas">
      <ul role="list">
        {capabilities.map((c) => <li><a href={`#${c.slug}`}>{c.title}</a></li>)}
      </ul>
    </nav>
  </PageHeader>

  <div class="container">
    {
      capabilities.map((c) => (
        <section class="capability" id={c.slug} aria-labelledby={`${c.slug}-title`}>
          <div class="capability__head" data-reveal>
            <Icon name={c.icon} size={28} class="capability__icon" />
            <h2 id={`${c.slug}-title`}>{c.title}</h2>
            <p class="capability__summary">{c.summary}</p>
          </div>
          <div class="capability__body">
            <div>
              <h3>What this can include</h3>
              <ul role="list" class="includes">
                {c.includes.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </div>
            <div>
              <h3>What it makes possible</h3>
              <p class="capability__outcome">{c.outcome}</p>
            </div>
            <div class="capability__evidence">
              {c.patterns.length > 0 ? (
                <>
                  <h3>See it in</h3>
                  <ul role="list">
                    {c.patterns.map((slug) => {
                      const p = patternBySlug(slug);
                      return (
                        <li>
                          <a href={url(`/work#${slug}`)}>
                            {p.title}
                          </a>
                        </li>
                      );
                    })}
                  </ul>
                </>
              ) : (
                <p class="capability__advisory">{advisoryNote}</p>
              )}
            </div>
          </div>
        </section>
      ))
    }

    <section class="section stack-section" aria-labelledby="stack-title">
      <SectionHead label="Stack" title="Tools and infrastructure we use" id="stack-title" />
      <StackList />
    </section>
  </div>

  <PartnerBand />
</Base>

<style>
  .jump ul {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.5rem;
    margin-top: 0.5rem;
  }
  .jump a {
    color: var(--ink);
    font-weight: 500;
    text-decoration: none;
    border-bottom: 1px solid var(--rule);
  }
  .jump a:hover {
    color: var(--blue);
    border-color: var(--blue);
  }

  .capability {
    display: grid;
    gap: 2rem;
    padding-block: clamp(3rem, 6vw, 5rem);
    border-bottom: 1px solid var(--rule);
    scroll-margin-top: 5rem;
  }
  @media (min-width: 64em) {
    .capability {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      gap: clamp(3rem, 6vw, 6rem);
    }
  }
  .capability__head {
    display: grid;
    gap: 1rem;
    align-content: start;
    justify-items: start;
  }
  .capability__head :global(.capability__icon) {
    color: var(--blue);
  }
  .capability__head h2 {
    font-size: var(--step-3);
  }
  .capability__summary {
    font-size: var(--step-1);
    line-height: 1.5;
  }

  .capability__body {
    display: grid;
    gap: 1.75rem;
    max-width: 44rem;
  }
  @media (min-width: 40em) {
    .capability__body {
      grid-template-columns: 1.3fr 1fr;
    }
    .capability__evidence {
      grid-column: 1 / -1;
    }
  }
  .capability__body h3 {
    margin-bottom: 0.75rem;
    font-size: 1rem;
    letter-spacing: 0;
  }
  .includes {
    list-style: none;
    display: grid;
    gap: 0.5rem;
  }
  .includes li {
    position: relative;
    padding-left: 1.25rem;
  }
  .includes li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.72em;
    width: 0.5rem;
    height: 1.5px;
    background: var(--blue);
  }
  .capability__outcome {
    color: var(--ink);
    font-size: var(--step-1);
    line-height: 1.45;
    font-weight: 500;
  }
  .capability__evidence {
    padding-top: 1.25rem;
    border-top: 1px solid var(--rule);
  }
  .capability__evidence ul {
    list-style: none;
    display: grid;
    gap: 0.4rem;
  }
  .capability__evidence a {
    font-weight: 500;
  }
  .capability__advisory {
    color: var(--text-muted);
  }

  .stack-section {
    display: grid;
    gap: 2rem;
  }
</style>
