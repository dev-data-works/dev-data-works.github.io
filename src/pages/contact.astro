---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import ContactCta from '../components/ContactCta.astro';
import { contact, org, has } from '../config/site';

const next = [
  `A team member replies within ${contact.replyTime}.`,
  'If it helps, we set up a call to understand your context.',
  'For reference requests, we send CVs and reference contacts.',
];
---

<Base
  title="Contact"
  description="Write to DevDataWorks about a proposal, a reference request or a new project. A team member replies within two working days."
>
  <PageHeader
    index="00"
    kicker="Contact"
    title="Talk to us."
    lede={`Write to us about a proposal, a reference request or a new project. A team member replies within ${contact.replyTime}.`}
  />

  <section class="section">
    <div class="container contact">
      <div class="contact__main">
        <ContactCta variant="page" />
        {
          has(org.location) && (
            <p class="contact__location">
              <span class="mono">Location</span> {org.location}
            </p>
          )
        }
      </div>

      <aside class="contact__aside" aria-labelledby="next-title">
        <h2 id="next-title" class="section-index">
          <span>What happens next</span>
        </h2>
        <ol role="list" class="next">
          {
            next.map((text, i) => (
              <li>
                <span class="next__num mono" aria-hidden="true">
                  {String(i + 1).padStart(2, '0')}
                </span>
                <p>{text}</p>
              </li>
            ))
          }
        </ol>
        <p class="privacy">This site stores nothing and loads no third-party scripts. Your email goes only to our mailbox.</p>
      </aside>
    </div>
  </section>
</Base>

<style>
  .contact {
    display: grid;
    gap: clamp(3rem, 6vw, 6rem);
  }
  @media (min-width: 60em) {
    .contact {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      align-items: start;
    }
  }
  .contact__main {
    display: grid;
    gap: 2rem;
    max-width: 40rem;
  }
  .contact__location {
    color: var(--text);
  }
  .contact__location .mono {
    margin-right: 0.75rem;
    font-size: 0.78rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .contact__aside {
    display: grid;
    gap: 1.5rem;
  }
  .contact__aside h2 {
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0.08em;
  }
  .next {
    list-style: none;
    display: grid;
    padding: 0;
    margin: 0;
  }
  .next li {
    display: grid;
    grid-template-columns: 2.5rem 1fr;
    gap: 0.5rem;
    padding-block: 1rem;
    border-bottom: 1px solid var(--rule);
    color: var(--ink);
  }
  .next__num {
    font-size: 0.85rem;
    color: var(--blue);
    padding-top: 0.15rem;
  }
  .privacy {
    font-size: 0.925rem;
    color: var(--text-muted);
  }
</style>
