---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import PartnerBand from '../components/PartnerBand.astro';
import SectionHead from '../components/SectionHead.astro';
import TeamRoles from '../components/TeamRoles.astro';
import ApproachSteps from '../components/ApproachSteps.astro';
import { principles } from '../data/content';
import { org, has } from '../config/site';

const facts = [
  { label: 'Legal name', value: org.legalName },
  { label: 'Registered in', value: org.jurisdiction },
  { label: 'Registration', value: org.registration },
  { label: 'Location', value: org.location },
].filter((f) => has(f.value));
---

<Base
  title="About us"
  description="DevDataWorks brings long experience in development programmes, partnerships with donors, NGOs and governments, enterprise technology, and the software and data systems behind them."
>
  <PageHeader
    kicker="About us"
    title="Long experience in development and the data behind it."
    lede="DevDataWorks brings together experience in development programmes, partnerships with donors, NGOs and governments, enterprise technology, and the software and data systems that support them. We work with organisations that need systems their teams can run and trust after we have left."
  />

  <section class="section" aria-labelledby="team-title">
    <div class="container stack">
      <SectionHead index="01" label="Who we are" title="The people who lead our work." id="team-title" />
      <TeamRoles variant="full" />
    </div>
  </section>

  <section class="section section--mist" aria-labelledby="principles-title">
    <div class="container stack">
      <SectionHead index="02" label="What guides us" title="The principles behind our work." id="principles-title" />
      <ul class="principles" role="list">
        {
          principles.map((p) => (
            <li class="principle">
              <h3>{p.title}</h3>
              <p>{p.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section" aria-labelledby="approach-title">
    <div class="container stack">
      <SectionHead index="03" label="How we work" title="How we work with partners." id="approach-title" />
      <ApproachSteps />
    </div>
  </section>

  {
    facts.length > 0 && (
      <section class="section section--rule" aria-labelledby="facts-title">
        <div class="container stack">
          <SectionHead index="04" label="Organisation" title="Organisation details" id="facts-title" />
          <dl class="facts">
            {facts.map((f) => (
              <div>
                <dt>{f.label}</dt>
                <dd>{f.value}</dd>
              </div>
            ))}
          </dl>
        </div>
      </section>
    )
  }

  <PartnerBand />
</Base>

<style>
  .stack {
    display: grid;
    gap: clamp(2rem, 4vw, 3.5rem);
  }
  .section--rule {
    border-top: 1px solid var(--rule);
  }
  .principles {
    list-style: none;
    display: grid;
    column-gap: clamp(2rem, 4vw, 3rem);
  }
  @media (min-width: 40em) {
    .principles {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 64em) {
    .principles {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  .principle {
    display: grid;
    align-content: start;
    gap: 0.6rem;
    padding-block: 1.5rem 2rem;
    border-top: 1px solid var(--ink);
  }
  .principle h3 {
    font-size: var(--step-2);
  }
  .facts {
    display: grid;
    margin: 0;
  }
  .facts div {
    display: grid;
    grid-template-columns: 12rem 1fr;
    padding-block: 0.85rem;
    border-bottom: 1px solid var(--rule);
  }
  .facts dt {
    color: var(--text-muted);
  }
  .facts dd {
    margin: 0;
    color: var(--ink);
  }
</style>
