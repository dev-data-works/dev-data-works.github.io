---
import ArcMotif from './ArcMotif.astro';

interface Props {
  /** Two-digit section number shown in the rule, e.g. "01". */
  index?: string;
  kicker: string;
  title: string;
  lede: string;
}
const { index, kicker, title, lede } = Astro.props;
---

<section class="page-header">
  <ArcMotif class="page-header__motif" />
  <div class="container page-header__inner">
    <p class="section-index">
      {index && <span class="section-index__num">{index}</span>}
      <span>{kicker}</span>
    </p>
    <h1>{title}</h1>
    <p class="lede">{lede}</p>
    <slot />
  </div>
</section>

<style>
  .page-header {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    padding-block: clamp(3.5rem, 8vw, 7rem) clamp(3rem, 6vw, 5rem);
    border-bottom: 1px solid var(--rule);
  }
  :global(.page-header__motif) {
    position: absolute;
    z-index: -1;
    width: clamp(26rem, 48vw, 44rem);
    right: clamp(-16rem, -10vw, -6rem);
    top: 50%;
    transform: translateY(-46%);
    opacity: 0.35;
  }
  @media (max-width: 48em) {
    :global(.page-header__motif) {
      right: -15rem;
      opacity: 0.25;
    }
  }
  .page-header__inner {
    display: grid;
    gap: 1.5rem;
    justify-items: start;
  }
  .page-header__inner > .section-index {
    width: 100%;
    max-width: 40rem;
  }
  h1 {
    max-width: 16ch;
    font-size: var(--step-6);
    line-height: 1;
  }
</style>
