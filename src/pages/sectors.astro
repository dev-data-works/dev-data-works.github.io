---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import PartnerBand from '../components/PartnerBand.astro';
import Icon from '../components/Icon.astro';
import { sectors, patternBySlug } from '../data/content';
import { url } from '../config/site';
---

<Base
  title="Sectors"
  description="Where DevDataWorks' system patterns apply: agriculture, water and sanitation, public health, climate and environment, education, and governance."
>
  <PageHeader
    kicker="Sectors"
    title="Where these systems apply."
    lede="The same patterns serve many sectors. These are the ones where they fit most often."
  />

  <section class="section" aria-label="Sectors">
    <div class="container">
      <ul class="sector-list" role="list">
        {
          sectors.map((s) => (
            <li class="sector" id={s.slug}>
              <Icon name={s.icon} size={28} class="sector__icon" />
              <h2>{s.title}</h2>
              <p class="sector__application">{s.application}</p>
              <ul class="sector__patterns" role="list" aria-label={`Patterns for ${s.title}`}>
                {s.patterns.map((slug) => {
                  const p = patternBySlug(slug);
                  return (
                    <li>
                      <a href={url(`/work#${slug}`)}>
                        <span class="mono">{p.index}</span> {p.title}
                      </a>
                    </li>
                  );
                })}
              </ul>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section section--mist" aria-labelledby="elsewhere-title">
    <div class="container elsewhere">
      <h2 id="elsewhere-title">Working somewhere else?</h2>
      <p class="lede">
        If your programme depends on collecting, sharing or using data, the same patterns apply. Tell us about it.
      </p>
    </div>
  </section>

  <div class="gap" aria-hidden="true"></div>
  <PartnerBand intents={['project', 'proposal']} />
</Base>

<style>
  .sector-list {
    list-style: none;
    display: grid;
    column-gap: clamp(2rem, 4vw, 3.5rem);
  }
  @media (min-width: 48em) {
    .sector-list {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 72em) {
    .sector-list {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .sector {
    display: grid;
    grid-template-rows: auto auto 1fr auto;
    gap: 0.85rem;
    padding-block: 1.75rem 2.25rem;
    border-top: 1px solid var(--ink);
    scroll-margin-top: 5rem;
  }
  .sector :global(.sector__icon) {
    color: var(--green-ink);
  }
  .sector h2 {
    font-size: var(--step-2);
    letter-spacing: -0.015em;
  }
  .sector__patterns {
    list-style: none;
    display: grid;
    gap: 0.35rem;
    padding-top: 0.85rem;
    border-top: 1px solid var(--rule);
    font-size: 0.95rem;
  }
  .sector__patterns a {
    font-weight: 500;
  }
  .sector__patterns .mono {
    display: inline-block;
    width: 1.9rem;
    font-size: 0.8rem;
  }
  .elsewhere {
    display: grid;
    gap: 1rem;
  }
  .gap {
    height: var(--section);
  }
</style>
