{
  "name": "devdataworks-website",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Official website of DevDataWorks",
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "check": "astro check",
    "og": "npx -y playwright-core@1.48.2 screenshot --viewport-size=1200,630 \"file://$PWD/scripts/og/og.html\" public/og-image.jpg",
    "check:links": "node scripts/check-links.mjs",
    "check:content": "node scripts/check-content.mjs",
    "test:checks": "node scripts/test-checks.mjs",
    "verify": "npm run build && npm run check:links && npm run check:content && npm run test:checks",
    "lighthouse": "npx -y @lhci/cli@0.14.0 autorun"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "astro": "^5.18.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "typescript": "^5.9.3"
  }
}
