---
/**
 * Hero illustration: the DevDataWorks mark (traced from the logo, see
 * src/assets/logo-mark.svg) centred on a round field of data points that
 * shares the logo circle's centre. Animated once on load (CSS
 * only): the field settles, the arc sweeps in, the bars rise one by one, the
 * leaf grounds them. Nothing animates under reduced motion.
 */
import markRaw from '../assets/logo-mark.svg?raw';

// Place the mark (viewBox 250 250 760 700) so the logo circle's centre
// (640, 637 in logo units, fitted to the arc) lands exactly on the canvas centre (280, 260).
const center = { x: 280, y: 260 };
const width = 420;
const scale = width / 760;
const mark = { x: +(center.x - (640 - 250) * scale).toFixed(2), y: +(center.y - (637 - 250) * scale).toFixed(2), width };
const height = Math.round(700 * scale);

// The logo's circle radius on the canvas; the dot field extends a little beyond it.
const ringR = 378 * scale; // outer edge of the arc
const markSvg = markRaw
  .replace(' role="img" aria-label="DevDataWorks"', '')
  .replace('<svg ', `<svg class="hv-mark" x="${mark.x}" y="${mark.y}" width="${mark.width}" height="${height}" `);

const outerR = ringR + 34;
---

<div class="hero-visual" aria-hidden="true">
  <svg viewBox="0 0 560 520" fill="none" xmlns="http://www.w3.org/2000/svg">
    <defs>
      <!-- offset so one dot sits exactly on the centre and the grid is symmetric around it -->
      <pattern id="hv-dots" x="18" y="18" width="20" height="20" patternUnits="userSpaceOnUse">
        <circle cx="2" cy="2" r="1.3" fill="#2a6f99"></circle>
      </pattern>
      <radialGradient id="hv-fade" gradientUnits="userSpaceOnUse" cx={center.x} cy={center.y} r={outerR + 10}>
        <stop offset="0" stop-color="#fff" stop-opacity="0.7"></stop>
        <stop offset="0.75" stop-color="#fff" stop-opacity="0.4"></stop>
        <stop offset="1" stop-color="#fff" stop-opacity="0"></stop>
      </radialGradient>
      <mask id="hv-mask">
        <circle cx={center.x} cy={center.y} r={outerR} fill="url(#hv-fade)"></circle>
      </mask>
    </defs>

    <!-- data field -->
    <rect class="hv-field" width="560" height="520" fill="url(#hv-dots)" mask="url(#hv-mask)"></rect>

    <!-- the mark itself -->
    <Fragment set:html={markSvg} />

  </svg>
</div>

<style>
  .hero-visual {
    width: 100%;
    max-width: 34rem;
    margin-inline: auto;
  }
  svg {
    width: 100%;
    height: auto;
    overflow: visible;
  }

  /* One orchestrated entrance. */
  .hv-field {
    animation: hv-fade 1.4s var(--ease) both;
  }
  :global(.hv-mark .lm-arc) {
    transform-box: view-box;
    transform-origin: 640px 637px;
    animation: hv-sweep 1.3s cubic-bezier(0.65, 0, 0.35, 1) 0.1s both;
  }
  :global(.hv-mark .lm-bar1),
  :global(.hv-mark .lm-bar2),
  :global(.hv-mark .lm-bar3) {
    transform-box: fill-box;
    transform-origin: 50% 100%;
    animation: hv-rise 0.9s var(--ease) both;
  }
  :global(.hv-mark .lm-bar1) {
    animation-delay: 0.5s;
  }
  :global(.hv-mark .lm-bar2) {
    animation-delay: 0.62s;
  }
  :global(.hv-mark .lm-bar3) {
    animation-delay: 0.74s;
  }
  :global(.hv-mark .lm-leaf) {
    transform-box: fill-box;
    transform-origin: 0% 100%;
    animation: hv-leaf 1s var(--ease) 0.4s both;
  }

  @keyframes hv-fade {
    from {
      opacity: 0;
    }
  }
  @keyframes hv-sweep {
    from {
      opacity: 0;
      transform: rotate(-40deg);
    }
  }
  @keyframes hv-rise {
    from {
      transform: scaleY(0);
    }
  }
  @keyframes hv-leaf {
    from {
      opacity: 0;
      transform: translate(-12px, 10px) scale(0.94);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hv-field,
    :global(.hv-mark .lm-arc),
    :global(.hv-mark .lm-bar1),
    :global(.hv-mark .lm-bar2),
    :global(.hv-mark .lm-bar3),
    :global(.hv-mark .lm-leaf) {
      animation: none;
    }
  }
</style>
